<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GFA Admin Dashboard</title>
  <style>
    :root {
      --dark-blue: #0f2d6b;
      --mid-blue: #1d4ed8;
      --light-blue: #60a5fa;
      --grey: #6b7280;
      --grey-light: #f3f4f6;
      --border: #d1d5db;
      --text: #111827;
      --white: #ffffff;
      --shadow: 0 10px 30px rgba(0,0,0,.08);
      --radius: 18px;
      --success: #166534;
      --warning: #92400e;
    }
    * { box-sizing:border-box; }
    body {
      margin: 0;
      font-family: Inter, Segoe UI, Arial, sans-serif;
      color: var(--text);
      background: #f8fafc;
    }
    .shell {
      width: min(100%, 1180px);
      margin: 0 auto;
      padding: 18px;
    }
    .card {
      background: var(--white);
      border: 1px solid rgba(209,213,219,.7);
      box-shadow: var(--shadow);
      border-radius: var(--radius);
      padding: 20px;
      margin-top: 16px;
    }
    .hero {
      background: linear-gradient(135deg, var(--dark-blue), var(--mid-blue), var(--light-blue));
      color: white;
    }
    input, select, textarea {
      width: 100%;
      padding: 12px 13px;
      border: 1px solid var(--border);
      border-radius: 12px;
      font-size: 1rem;
    }
    button, .btn {
      border: none;
      border-radius: 12px;
      padding: 12px 15px;
      font-size: .96rem;
      font-weight: 700;
      cursor: pointer;
      text-decoration:none;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
    }
    .primary { background: linear-gradient(135deg, var(--dark-blue), var(--mid-blue)); color: white; }
    .secondary { background: var(--grey-light); color: var(--text); }
    .danger { background: #111827; color: white; }
    .row { display:flex; gap:12px; flex-wrap:wrap; }
    .grid { display:grid; grid-template-columns: repeat(4, 1fr); gap:12px; }
    @media (max-width: 900px) { .grid { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
    table { width:100%; border-collapse: collapse; font-size:.94rem; }
    th, td { text-align:left; padding: 12px 10px; border-bottom:1px solid #e5e7eb; vertical-align: top; }
    th { font-size:.9rem; color:#374151; background:#f8fafc; position: sticky; top:0; }
    .badge {
      display:inline-flex; padding: 6px 10px; border-radius:999px; font-size:.82rem; font-weight:700;
      background:#e5e7eb; color:#111827;
    }
    .badge.pending { background:#fef3c7; color:#92400e; }
    .badge.contacted { background:#dbeafe; color:#1d4ed8; }
    .badge.completed { background:#dcfce7; color:#166534; }
    .stats { display:grid; grid-template-columns: repeat(4, 1fr); gap:12px; }
    @media (max-width: 800px) { .stats { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 560px) { .stats { grid-template-columns: 1fr; } }
    .stat { background: #f8fafc; border: 1px solid #e5e7eb; border-radius: 16px; padding: 16px; }
    .stat .label { color:#6b7280; font-size:.9rem; }
    .stat .value { font-size: 1.8rem; font-weight:800; margin-top:6px; }
    .hidden { display:none !important; }
    .muted { color:#6b7280; }
    .modal {
      position: fixed; inset:0; background: rgba(17,24,39,.45); display:none; align-items:center; justify-content:center; padding:20px;
    }
    .modal.show { display:flex; }
    .modal-card {
      width:min(100%, 760px); max-height: 88vh; overflow:auto; background:white; border-radius:20px; box-shadow: var(--shadow); padding:20px;
    }
    .toolbar { display:flex; justify-content:space-between; gap:10px; flex-wrap:wrap; align-items:center; }
  </style>
</head>
<body>
  <div class="shell">
    <section id="loginCard" class="card hero">
      <h1 style="margin:0 0 8px;">God's Family Assembly Admin</h1>
      <p style="margin:0 0 18px; opacity:.95;">Secure login for follow up team and church administrators.</p>
      <form id="loginForm" class="row">
        <div style="flex:1 1 240px;">
          <input id="username" placeholder="Username" value="admin" />
        </div>
        <div style="flex:1 1 240px;">
          <input id="password" type="password" placeholder="Password" value="Admin@123" />
        </div>
        <div>
          <button class="secondary" type="submit">Login</button>
        </div>
      </form>
      <p class="muted" id="loginMsg" style="color:#dbeafe;"></p>
    </section>

    <section id="dashboard" class="hidden">
      <div class="toolbar">
        <div>
          <h2 style="margin:0;">First Timers Dashboard</h2>
          <p class="muted" style="margin:6px 0 0;">Search, filter, update follow up, and export submissions.</p>
        </div>
        <div class="row">
          <a href="/form" class="btn secondary">View Public Form</a>
          <button id="exportBtn" class="btn secondary" type="button">Export CSV</button>
          <button id="logoutBtn" class="btn danger" type="button">Logout</button>
        </div>
      </div>

      <section class="card">
        <div class="stats" id="stats"></div>
      </section>

      <section class="card">
        <div class="grid">
          <div><input id="search" placeholder="Search by name or phone" /></div>
          <div>
            <select id="statusFilter">
              <option value="">All follow up statuses</option>
              <option>Pending</option>
              <option>Contacted</option>
              <option>Completed</option>
            </select>
          </div>
          <div>
            <select id="contactFilter">
              <option value="">All contact methods</option>
              <option>Call</option>
              <option>WhatsApp</option>
            </select>
          </div>
          <div>
            <select id="serviceFilter">
              <option value="">All services</option>
              <option>Sunday 7:00 AM</option>
              <option>Sunday 9:00 AM</option>
              <option>Midweek Service</option>
              <option>Special Program</option>
            </select>
          </div>
        </div>
      </section>

      <section class="card">
        <div style="overflow:auto;">
          <table>
            <thead>
              <tr>
                <th>Name</th>
                <th>Phone</th>
                <th>Service</th>
                <th>Follow Up</th>
                <th>Contact Method</th>
                <th>Department</th>
                <th>Date</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="tableBody">
              <tr><td colspan="8" class="muted">Loading...</td></tr>
            </tbody>
          </table>
        </div>
      </section>
    </section>
  </div>

  <div class="modal" id="detailModal">
    <div class="modal-card">
      <div class="toolbar">
        <h3 style="margin:0;">Visitor Details</h3>
        <button class="secondary" id="closeModalBtn" type="button">Close</button>
      </div>
      <div id="detailContent" style="margin-top:14px;"></div>
      <hr style="margin:22px 0; border:none; border-top:1px solid #e5e7eb;" />
      <div class="grid">
        <div>
          <label>Follow up status</label>
          <select id="detailStatus">
            <option>Pending</option>
            <option>Contacted</option>
            <option>Completed</option>
          </select>
        </div>
        <div class="hidden" aria-hidden="true"></div>
        <div style="grid-column: span 2;">
          <label>Internal notes</label>
          <textarea id="detailNotes" rows="5"></textarea>
        </div>
      </div>
      <div class="row" style="margin-top:16px;">
        <button id="saveDetailBtn" class="primary" type="button">Save Changes</button>
      </div>
    </div>
  </div>

  <script>
    const tokenKey = 'gfa_admin_token_v1';
    let currentId = null;

    const loginCard = document.getElementById('loginCard');
    const dashboard = document.getElementById('dashboard');
    const loginForm = document.getElementById('loginForm');
    const loginMsg = document.getElementById('loginMsg');
    const tableBody = document.getElementById('tableBody');
    const statsWrap = document.getElementById('stats');
    const search = document.getElementById('search');
    const statusFilter = document.getElementById('statusFilter');
    const contactFilter = document.getElementById('contactFilter');
    const serviceFilter = document.getElementById('serviceFilter');
    const detailModal = document.getElementById('detailModal');
    const detailContent = document.getElementById('detailContent');
    const detailStatus = document.getElementById('detailStatus');
    const detailNotes = document.getElementById('detailNotes');

    function getToken() { return localStorage.getItem(tokenKey); }
    function setToken(token) { localStorage.setItem(tokenKey, token); }
    function clearToken() { localStorage.removeItem(tokenKey); }

    function fmt(v) { return v == null || v === '' ? '<span class="muted">—</span>' : String(v); }

    function badge(status) {
      const cls = status.toLowerCase();
      return `<span class="badge ${cls}">${status}</span>`;
    }

    function authHeaders() {
      return { 'Authorization': 'Bearer ' + getToken(), 'Content-Type': 'application/json' };
    }

    async function login(username, password) {
      const res = await fetch('/api/admin/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, password })
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.error || 'Login failed');
      return json;
    }

    async function fetchStats() {
      const res = await fetch('/api/admin/analytics', { headers: authHeaders() });
      if (res.status === 401) throw new Error('Session expired');
      const json = await res.json();
      statsWrap.innerHTML = `
        <div class="stat"><div class="label">Total first timers</div><div class="value">${json.summary.total}</div></div>
        <div class="stat"><div class="label">Need follow up</div><div class="value">${json.summary.want_contact}</div></div>
        <div class="stat"><div class="label">Interested in departments</div><div class="value">${json.summary.want_department}</div></div>
        <div class="stat"><div class="label">This week</div><div class="value">${json.summary.this_week}</div></div>
      `;
    }

    async function fetchRows() {
      const params = new URLSearchParams();
      if (search.value.trim()) params.set('q', search.value.trim());
      if (statusFilter.value) params.set('status', statusFilter.value);
      if (contactFilter.value) params.set('contact_method', contactFilter.value);
      if (serviceFilter.value) params.set('service', serviceFilter.value);

      const res = await fetch('/api/admin/first-timers?' + params.toString(), { headers: authHeaders() });
      if (res.status === 401) throw new Error('Session expired');
      const rows = await res.json();
      if (!Array.isArray(rows) || rows.length === 0) {
        tableBody.innerHTML = '<tr><td colspan="8" class="muted">No submissions found.</td></tr>';
        return;
      }
      tableBody.innerHTML = rows.map(r => `
        <tr>
          <td>${fmt(r.full_name)}</td>
          <td>${fmt(r.phone)}</td>
          <td>${fmt(r.service)}</td>
          <td>${badge(r.follow_up_status || 'Pending')}</td>
          <td>${fmt(r.contact_method)}</td>
          <td>${fmt(r.departments)}</td>
          <td>${fmt(r.date_of_visit)}</td>
          <td><button class="secondary" type="button" onclick="openDetails(${r.id})">Details</button></td>
        </tr>
      `).join('');
    }

    async function openDetails(id) {
      currentId = id;
      const res = await fetch('/api/admin/first-timers/' + id, { headers: authHeaders() });
      const r = await res.json();
      detailContent.innerHTML = `
        <div class="grid">
          <div><strong>Name</strong><div>${fmt(r.full_name)}</div></div>
          <div><strong>Phone</strong><div>${fmt(r.phone)}</div></div>
          <div><strong>Email</strong><div>${fmt(r.email)}</div></div>
          <div><strong>Address</strong><div>${fmt(r.address)}</div></div>
          <div><strong>Gender</strong><div>${fmt(r.gender)}</div></div>
          <div><strong>Age Range</strong><div>${fmt(r.age_range)}</div></div>
          <div><strong>Marital Status</strong><div>${fmt(r.marital_status)}</div></div>
          <div><strong>Occupation</strong><div>${fmt(r.occupation)}</div></div>
          <div><strong>How they heard</strong><div>${fmt(r.how_you_heard)}</div></div>
          <div><strong>First time</strong><div>${fmt(r.is_first_time)}</div></div>
          <div><strong>Wants contact</strong><div>${fmt(r.want_contact)}</div></div>
          <div><strong>Contact method</strong><div>${fmt(r.contact_method)}</div></div>
          <div style="grid-column: span 2;"><strong>Prayer request</strong><div>${fmt(r.prayer_request)}</div></div>
          <div><strong>Wants department</strong><div>${fmt(r.want_department)}</div></div>
          <div><strong>Departments</strong><div>${fmt(r.departments)}</div></div>
          <div><strong>Service</strong><div>${fmt(r.service)}</div></div>
          <div><strong>Date of visit</strong><div>${fmt(r.date_of_visit)}</div></div>
        </div>
      `;
      detailStatus.value = r.follow_up_status || 'Pending';
      detailNotes.value = r.follow_up_notes || '';
      detailModal.classList.add('show');
    }
    window.openDetails = openDetails;

    async function saveDetails() {
      const res = await fetch('/api/admin/first-timers/' + currentId, {
        method: 'PATCH',
        headers: authHeaders(),
        body: JSON.stringify({
          follow_up_status: detailStatus.value,
          follow_up_notes: detailNotes.value
        })
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.error || 'Save failed');
      detailModal.classList.remove('show');
      await refreshData();
    }

    async function refreshData() {
      await Promise.all([fetchStats(), fetchRows()]);
    }

    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      loginMsg.textContent = 'Signing in...';
      try {
        const json = await login(
          document.getElementById('username').value,
          document.getElementById('password').value
        );
        setToken(json.token);
        loginCard.classList.add('hidden');
        dashboard.classList.remove('hidden');
        await refreshData();
      } catch (err) {
        loginMsg.textContent = err.message;
      }
    });

    document.getElementById('logoutBtn').addEventListener('click', () => {
      clearToken();
      location.reload();
    });
    document.getElementById('closeModalBtn').addEventListener('click', () => detailModal.classList.remove('show'));
    document.getElementById('saveDetailBtn').addEventListener('click', saveDetails);
    document.getElementById('exportBtn').addEventListener('click', () => {
      window.open('/api/admin/export-csv?token=' + encodeURIComponent(getToken()), '_blank');
    });

    [search, statusFilter, contactFilter, serviceFilter].forEach(el => {
      el.addEventListener('input', () => refreshData().catch(handleAuthError));
      el.addEventListener('change', () => refreshData().catch(handleAuthError));
    });

    function handleAuthError(err) {
      if (String(err.message).includes('expired')) {
        clearToken();
        location.reload();
      }
    }

    (async function boot() {
      if (!getToken()) return;
      loginCard.classList.add('hidden');
      dashboard.classList.remove('hidden');
      try {
        await refreshData();
      } catch (err) {
        handleAuthError(err);
      }
    })();
  </script>
</body>
</html>
